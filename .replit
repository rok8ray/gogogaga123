modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Run App"

[[workflows.workflow]]
name = "Run App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx serve ."
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
